# ==============================================================================
# VESPER Environment Variables Configuration
# ==============================================================================

# TMDb API Key for movies, shows, cast, and release date lookups
# (Default fallback is built-in, but your own key is recommended)
TMDB_API_KEY=802b2c4b88ea1183e50e6b285a27696e

# PostgreSQL Database URL (Render automatically provides this if you create a Postgres Database)
# Format: postgresql://username:password@hostname:port/database_name
# If left empty, VESPER will use a local SQLite database (media_tracker.db)
DATABASE_URL=

# Default ntfy.sh topic for system-wide alerts & cron release checks
NTFY_TOPIC=vesper-cinema-updates

# Optional: Server Port (Render sets this automatically)
# PORT=8000
